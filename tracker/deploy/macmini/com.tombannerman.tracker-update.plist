<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs the tracker update every day at 06:45 in the Mac's local time zone (set it to Australia/Brisbane).
     Install: see tracker/README.md, "Mac mini". __HOME__ is replaced by your home folder during install. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tombannerman.tracker-update</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__HOME__/sites/tombannerman.com/tracker/deploy/macmini/tracker-update.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>45</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/tracker-update.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/tracker-update.launchd.log</string>
</dict>
</plist>
